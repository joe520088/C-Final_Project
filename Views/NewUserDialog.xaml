<Window x:Class="CreativeWrites.Views.NewUserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Profile" Height="220" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="20">

        <TextBlock Text="Username" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox x:Name="UsernameBox" Padding="8,5" BorderBrush="#CCCCCC"
                 BorderThickness="1" FontSize="13" Margin="0,0,0,12"/>

        <TextBlock Text="Bio (optional)" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox x:Name="BioBox" Padding="8,5" BorderBrush="#CCCCCC"
                 BorderThickness="1" FontSize="13"
                 AcceptsReturn="True" Height="50" Margin="0,0,0,16"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Padding="12,6" Margin="0,0,8,0"
                    IsCancel="True"/>
            <Button Content="Create" Padding="12,6" IsDefault="True"
                    Background="#3B3F8C" Foreground="White" BorderThickness="0"
                    Cursor="Hand" Click="OnCreate"/>
        </StackPanel>

    </StackPanel>
</Window>
