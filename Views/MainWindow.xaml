<Window x:Class="CreativeWrites.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CreativeWrites.ViewModels"
        xmlns:models="clr-namespace:CreativeWrites.Models"
        xmlns:conv="clr-namespace:CreativeWrites.Converters"
        Title="Creative Writes" Height="750" Width="1100" MinWidth="900" MinHeight="600"
        Background="#F5F4F0">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
        <conv:EqualityToVisibilityMultiConverter x:Key="OwnerToVisibility"/>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static vm:AppView.Feed}">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- ══ LEFT SIDEBAR ══════════════════════════════════════════════ -->
        <Border Grid.Column="0" Background="#3B3F8C" Padding="12">
            <StackPanel>

                <TextBlock Text="✍ Creative Writes" Foreground="White"
                           FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                <TextBlock Text="Active User" Foreground="#AAAACC" FontSize="11" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding ActiveUser.Username, FallbackValue='None'}"
                           Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

                <Button Content="My Profile" Command="{Binding MyProfileCommand}"
                        Background="#5559AA" Foreground="White" Padding="10,5"
                        BorderThickness="0" Cursor="Hand" Margin="0,0,0,16"
                        HorizontalAlignment="Left"
                        Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibility}}"/>

                <TextBlock Text="Switch User" Foreground="#AAAACC" FontSize="11" Margin="0,0,0,6"/>
                <ListBox ItemsSource="{Binding Users}"
                         SelectedItem="{Binding ActiveUser}"
                         Background="Transparent" BorderThickness="0" Margin="0,0,0,12">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Username}" Foreground="White"
                                       FontSize="13" Padding="4,3"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#5559AA"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <Button Content="+ New Profile" Click="OnNewProfileClicked"
                        Background="#5559AA" Foreground="White" Padding="12,6"
                        BorderThickness="0" Cursor="Hand" Margin="0,0,0,24"/>

                <Separator Background="#5559AA" Margin="0,0,0,16"/>

                <TextBlock Text="Filter by Genre" Foreground="#AAAACC" FontSize="11" Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding GenreFilters}"
                          SelectedItem="{Binding SelectedGenreFilter}"
                          DisplayMemberPath="Name"
                          Margin="0,0,0,8"/>

                <TextBlock Text="Search" Foreground="#AAAACC" FontSize="11" Margin="0,0,0,4"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,5" BorderBrush="#CCCCCC" BorderThickness="1"
                         FontSize="13" Margin="0,0,0,6"/>

                <Button Content="Clear Filters" Command="{Binding ClearFilterCommand}"
                        Background="#444477" Foreground="White" Padding="12,6"
                        BorderThickness="0" Cursor="Hand"/>

            </StackPanel>
        </Border>

        <!-- ══ STORY FEED ════════════════════════════════════════════════ -->
        <Border Grid.Column="1" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Story Feed" FontSize="20" FontWeight="Bold"
                           Foreground="#3B3F8C" Margin="0,0,0,12"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="No stories yet — be the first to publish one"
                                   Foreground="#888888" FontSize="13" FontStyle="Italic"
                                   Margin="0,16,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AllStories.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="No stories match your filter — try clearing it"
                                   Foreground="#888888" FontSize="13" FontStyle="Italic"
                                   Margin="0,16,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FeedStories.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding AllStories.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding FeedStories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" CornerRadius="6" Padding="14"
                                        Margin="0,0,0,10" Cursor="Hand"
                                        BorderBrush="#E0E0E0" BorderThickness="1"
                                        MouseLeftButtonUp="OnStoryCardClicked">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="16"
                                                   FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                                            <TextBlock Text="{Binding AuthorName}" Cursor="Hand"
                                                       MouseLeftButtonUp="OnAuthorClicked"
                                                       Foreground="#888888" FontSize="12"
                                                       TextDecorations="Underline"/>
                                            <TextBlock Text=" · " Foreground="#888888" FontSize="12"/>
                                            <TextBlock Text="{Binding Genre}"
                                                       Foreground="#E8865A" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text=" · " Foreground="#888888" FontSize="12"/>
                                            <TextBlock Text="{Binding PublishedAt, StringFormat='MMM d, yyyy h:mm tt'}"
                                                       Foreground="#888888" FontSize="12"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding LastEditedAt, StringFormat='Edited {0:MMM d, yyyy h:mm tt}'}"
                                                   Foreground="#AAAAAA" FontSize="11" FontStyle="Italic"
                                                   Margin="0,0,0,6">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEdited}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Body}" TextWrapping="Wrap"
                                                   MaxHeight="60" Foreground="#555555" FontSize="13"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="♥ " Foreground="#E8865A"/>
                                            <TextBlock Text="{Binding LikeCount}" Foreground="#888888" FontSize="12"/>
                                            <TextBlock Text=" · " Foreground="#888888" FontSize="12"/>
                                            <TextBlock Text="{Binding Comments.Count, StringFormat='{}{0} comments'}"
                                                       Foreground="#888888" FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ══ RIGHT PANEL ═══════════════════════════════════════════════ -->
        <Border Grid.Column="2" Background="White"
                BorderBrush="#E0E0E0" BorderThickness="1,0,0,0" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="Write Story" Click="OnShowWritePanel"
                            Background="#3B3F8C" Foreground="White" Padding="12,6"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"/>
                    <Button Content="Story Detail" Click="OnShowDetailPanel"
                            Background="#888888" Foreground="White" Padding="12,6"
                            BorderThickness="0" Cursor="Hand"/>
                </StackPanel>

                <!-- ── Write Panel ── -->
                <ScrollViewer Grid.Row="1" x:Name="WritePanelScroll"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Not logged in message -->
                        <TextBlock Text="Create a profile (+ New Profile) to post stories."
                                   TextWrapping="Wrap" Foreground="#888888">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoggedIn}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Write form (logged in only) -->
                        <StackPanel Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibility}}">

                            <TextBlock Text="New Story" FontSize="16" FontWeight="Bold"
                                       Foreground="#3B3F8C" Margin="0,0,0,12"/>

                            <TextBlock Text="Title" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding WriteTitle, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,5" BorderBrush="#CCCCCC" BorderThickness="1"
                                     FontSize="13" Margin="0,0,0,10"/>

                            <TextBlock Text="Genre" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,10">
                                <ComboBox ItemsSource="{Binding Source={x:Static models:GenreValues.All}}"
                                          SelectedItem="{Binding WriteGenre}"/>
                                <TextBlock Text="Select a genre…" IsHitTestVisible="False"
                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                           Foreground="#888888" FontStyle="Italic"
                                           Visibility="{Binding WriteGenre, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}"/>
                            </Grid>

                            <TextBlock Text="Body" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding WriteBody, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,5" BorderBrush="#CCCCCC" BorderThickness="1"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="180" VerticalScrollBarVisibility="Auto"
                                     FontSize="13" Margin="0,0,0,12"/>

                            <Button Content="Publish Story" Command="{Binding PublishStoryCommand}"
                                    Background="#3B3F8C" Foreground="White" Padding="12,6"
                                    BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ── Detail Panel ── -->
                <ScrollViewer Grid.Row="1" x:Name="DetailPanelScroll"
                              Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- No story selected -->
                        <TextBlock Text="Select a story from the feed to view details."
                                   Foreground="#888888" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedStory}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Story detail content -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedStory}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- ── Story READ view ── -->
                            <StackPanel Visibility="{Binding IsEditingStory, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">

                                <TextBlock Text="{Binding SelectedStory.Title}" FontSize="17"
                                           FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,6"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding SelectedStory.AuthorName}" Cursor="Hand"
                                               MouseLeftButtonUp="OnAuthorClicked"
                                               Foreground="#888888" FontSize="12"
                                               TextDecorations="Underline"/>
                                    <TextBlock Text=" · " Foreground="#888888" FontSize="12"/>
                                    <TextBlock Text="{Binding SelectedStory.Genre}"
                                               Foreground="#E8865A" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>

                                <TextBlock Text="{Binding SelectedStory.PublishedAt, StringFormat='Posted {0:MMM d, yyyy h:mm tt}'}"
                                           Foreground="#888888" FontSize="11" Margin="0,0,0,2"/>

                                <TextBlock Text="{Binding SelectedStory.LastEditedAt, StringFormat='Edited {0:MMM d, yyyy h:mm tt}'}"
                                           Foreground="#AAAAAA" FontSize="11" FontStyle="Italic"
                                           Margin="0,0,0,10">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedStory.IsEdited}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Text="{Binding SelectedStory.Body}" TextWrapping="Wrap"
                                           FontSize="13" Foreground="#333333" Margin="0,0,0,12"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Button Click="OnLikeStory" Foreground="White" Padding="12,6"
                                            BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Content" Value="♥ Like"/>
                                                <Setter Property="Background" Value="#E8865A"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasLikedSelectedStory}" Value="True">
                                                        <Setter Property="Content" Value="♥ Liked"/>
                                                        <Setter Property="Background" Value="#C0392B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Content="Edit" Command="{Binding StartEditStoryCommand}"
                                            Background="#3B3F8C" Foreground="White" Padding="10,5"
                                            BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                                        <Button.Visibility>
                                            <MultiBinding Converter="{StaticResource OwnerToVisibility}">
                                                <Binding Path="SelectedStory.AuthorId"/>
                                                <Binding Path="ActiveUser.UserId"/>
                                            </MultiBinding>
                                        </Button.Visibility>
                                    </Button>

                                    <Button Content="Delete Story" Click="OnDeleteStory"
                                            Background="#C0392B" Foreground="White" Padding="10,5"
                                            BorderThickness="0" Cursor="Hand">
                                        <Button.Visibility>
                                            <MultiBinding Converter="{StaticResource OwnerToVisibility}">
                                                <Binding Path="SelectedStory.AuthorId"/>
                                                <Binding Path="ActiveUser.UserId"/>
                                            </MultiBinding>
                                        </Button.Visibility>
                                    </Button>
                                </StackPanel>

                                <!-- ── AI Likeness scan ── -->
                                <Border Background="#F9F9F9" CornerRadius="6" Padding="14" Margin="0,0,0,16"
                                        BorderBrush="#E0E0E0" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="AI Likeness" FontWeight="Bold" FontSize="13"
                                                   Foreground="#3B3F8C" Margin="0,0,0,8"/>

                                        <!-- Idle: not scanned, not scanning -->
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding SelectedStory.AiScore}" Value="{x:Null}"/>
                                                                <Condition Binding="{Binding SelectedStory.IsScanning}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="Not yet scanned" Foreground="#888888"
                                                       FontStyle="Italic" Margin="0,0,0,8"/>
                                            <Button Content="Scan for AI" Command="{Binding ScanForAiCommand}"
                                                    Background="#3B3F8C" Foreground="White" Padding="10,5"
                                                    BorderThickness="0" Cursor="Hand"
                                                    HorizontalAlignment="Left"/>
                                        </StackPanel>

                                        <!-- Scanning -->
                                        <StackPanel Visibility="{Binding SelectedStory.IsScanning, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Scanning…" Foreground="#3B3F8C"
                                                       FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <ProgressBar IsIndeterminate="True" Height="8"/>
                                        </StackPanel>

                                        <!-- Scored: has score, not scanning -->
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedStory.IsScanning}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedStory.AiScore}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Margin="0,0,0,4">
                                                <Run Text="AI Likeness: " FontSize="14"/>
                                                <Run Text="{Binding SelectedStory.AiScore, Mode=OneWay}"
                                                     FontSize="22" FontWeight="Bold" Foreground="#3B3F8C"/>
                                                <Run Text="%" FontSize="14"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding SelectedStory.AiVerdict}"
                                                       Foreground="#888888" FontStyle="Italic"
                                                       Margin="0,0,0,8"/>
                                            <Button Content="Re-scan" Command="{Binding ScanForAiCommand}"
                                                    Background="#888888" Foreground="White" Padding="10,5"
                                                    BorderThickness="0" Cursor="Hand"
                                                    HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ── Story EDIT view ── -->
                            <StackPanel Visibility="{Binding IsEditingStory, Converter={StaticResource BoolToVisibility}}"
                                        Margin="0,0,0,16">

                                <TextBlock Text="Edit Story" FontSize="16" FontWeight="Bold"
                                           Foreground="#3B3F8C" Margin="0,0,0,12"/>

                                <TextBlock Text="Title" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditTitleDraft, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,5" BorderBrush="#CCCCCC" BorderThickness="1"
                                         FontSize="13" Margin="0,0,0,10"/>

                                <TextBlock Text="Genre" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox SelectedItem="{Binding EditGenreDraft}"
                                          ItemsSource="{Binding Source={x:Static models:GenreValues.All}}"
                                          Margin="0,0,0,10"/>

                                <TextBlock Text="Body" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditBodyDraft, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,5" BorderBrush="#CCCCCC" BorderThickness="1"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         MinHeight="180" VerticalScrollBarVisibility="Auto"
                                         FontSize="13" Margin="0,0,0,12"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Save" Command="{Binding SaveEditStoryCommand}"
                                            Background="#3B3F8C" Foreground="White" Padding="12,6"
                                            BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"/>
                                    <Button Content="Cancel" Command="{Binding CancelEditStoryCommand}"
                                            Background="#888888" Foreground="White" Padding="12,6"
                                            BorderThickness="0" Cursor="Hand"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="Comments" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

                            <ItemsControl ItemsSource="{Binding SelectedStory.Comments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8" Margin="0,0,0,6"
                                                Background="#F9F9F9" CornerRadius="4"
                                                BorderBrush="#EEEEEE" BorderThickness="1">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding AuthorName}" Cursor="Hand"
                                                               MouseLeftButtonUp="OnAuthorClicked"
                                                               FontWeight="SemiBold" FontSize="12"
                                                               TextDecorations="Underline"/>
                                                    <TextBlock Text=" · " Foreground="#888888" FontSize="12"/>
                                                    <TextBlock Text="{Binding PostedAt, StringFormat='MMM d, yyyy h:mm tt'}"
                                                               Foreground="#888888" FontSize="12"/>
                                                </StackPanel>

                                                <!-- Comment READ view -->
                                                <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                                    <TextBlock Text="{Binding Body}" TextWrapping="Wrap"
                                                               FontSize="13" Margin="0,2,0,4"/>

                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel.Visibility>
                                                            <MultiBinding Converter="{StaticResource OwnerToVisibility}">
                                                                <Binding Path="AuthorId"/>
                                                                <Binding Path="DataContext.ActiveUser.UserId"
                                                                         RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                            </MultiBinding>
                                                        </StackPanel.Visibility>

                                                        <Button Content="Edit"
                                                                Command="{Binding DataContext.StartEditCommentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Background="#3B3F8C" Foreground="White"
                                                                Padding="8,3" BorderThickness="0"
                                                                Cursor="Hand" FontSize="11" Margin="0,0,6,0"/>
                                                        <Button Content="Delete" Click="OnDeleteComment"
                                                                Tag="{Binding CommentId}"
                                                                Background="#C0392B" Foreground="White"
                                                                Padding="8,3" BorderThickness="0"
                                                                Cursor="Hand" FontSize="11"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Comment EDIT view -->
                                                <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                                                            Margin="0,4,0,0">
                                                    <TextBox Text="{Binding EditDraft, UpdateSourceTrigger=PropertyChanged}"
                                                             Padding="6,4" BorderBrush="#CCCCCC" BorderThickness="1"
                                                             AcceptsReturn="True" TextWrapping="Wrap"
                                                             MinHeight="50" FontSize="13" Margin="0,0,0,6"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="Save"
                                                                Command="{Binding DataContext.SaveEditCommentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Background="#3B3F8C" Foreground="White"
                                                                Padding="8,3" BorderThickness="0"
                                                                Cursor="Hand" FontSize="11" Margin="0,0,6,0"/>
                                                        <Button Content="Cancel"
                                                                Command="{Binding DataContext.CancelEditCommentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Background="#888888" Foreground="White"
                                                                Padding="8,3" BorderThickness="0"
                                                                Cursor="Hand" FontSize="11"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Add a comment:" FontWeight="SemiBold"
                                       Margin="0,8,0,4"/>
                            <TextBox x:Name="CommentBox" Padding="8,5"
                                     BorderBrush="#CCCCCC" BorderThickness="1"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="60" FontSize="13" Margin="0,0,0,6"/>
                            <Button Content="Post Comment" Click="OnPostComment"
                                    Background="#3B3F8C" Foreground="White" Padding="12,6"
                                    BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left"/>

                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Border>
    </Grid>

    <!-- ══ PROFILE VIEW ══════════════════════════════════════════════ -->
    <Grid Background="#F5F4F0">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static vm:AppView.Profile}">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,32,40,40" MaxWidth="800" HorizontalAlignment="Center">

                <Button Content="← Back to Feed" Command="{Binding BackToFeedCommand}"
                        Background="#888888" Foreground="White" Padding="10,5"
                        BorderThickness="0" Cursor="Hand"
                        HorizontalAlignment="Left" Margin="0,0,0,24"/>

                <TextBlock Text="{Binding ProfileUser.Username}" FontSize="32"
                           FontWeight="Bold" Foreground="#3B3F8C"/>

                <TextBlock Text="{Binding ProfileJoinedDisplay}"
                           Foreground="#888888" FontSize="13" Margin="0,2,0,16"/>

                <TextBlock Text="{Binding ProfileUser.Bio}" TextWrapping="Wrap"
                           FontSize="14" Foreground="#333333" Margin="0,0,0,24"/>

                <!-- Stats row -->
                <Grid Margin="0,0,0,32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="6" Padding="20"
                            BorderBrush="#E0E0E0" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding ProfileStoryCount}" FontSize="32"
                                       FontWeight="Bold" Foreground="#3B3F8C"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Stories" Foreground="#888888"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="White" CornerRadius="6" Padding="20"
                            BorderBrush="#E0E0E0" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding ProfileTotalLikes}" FontSize="32"
                                       FontWeight="Bold" Foreground="#E8865A"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Likes received" Foreground="#888888"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Background="White" CornerRadius="6" Padding="20"
                            BorderBrush="#E0E0E0" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding ProfileAverageAiDisplay}" FontSize="32"
                                       FontWeight="Bold" Foreground="#3B3F8C"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Avg AI score" Foreground="#888888"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="Stories" FontSize="20" FontWeight="Bold"
                           Foreground="#3B3F8C" Margin="0,0,0,12"/>

                <TextBlock Text="No stories yet" Foreground="#888888"
                           FontStyle="Italic" Margin="0,8,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ProfileStoryCount}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding ProfileUserStories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="6" Padding="14"
                                    Margin="0,0,0,10" Cursor="Hand"
                                    BorderBrush="#E0E0E0" BorderThickness="1">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.OpenProfileStoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="16"
                                               FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Genre}"
                                                   Foreground="#E8865A" FontSize="12"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text=" · " Foreground="#888888" FontSize="12"/>
                                        <TextBlock Text="{Binding PublishedAt, StringFormat='MMM d, yyyy'}"
                                                   Foreground="#888888" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="♥ " Foreground="#E8865A"/>
                                        <TextBlock Text="{Binding LikeCount}" Foreground="#888888"/>
                                        <TextBlock Text=" · " Foreground="#888888" FontSize="12"/>
                                        <TextBlock Text="{Binding Comments.Count, StringFormat='{}{0} comments'}"
                                                   Foreground="#888888" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>

    </Grid>
</Window>
